{
  "name": "stockflow-backend",
  "version": "1.0.0",
  "description": "StockFlow Inventory Management System - Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "npm run db:generate:sqlite && npm run db:push:sqlite && nodemon src/index.js",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:push:sqlite": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1"
  }
}
